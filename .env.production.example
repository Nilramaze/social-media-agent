# Production env for docker-compose.prod.yml. Copy to `.env` on the VPS and
# fill in every value. DATABASE_URL, REDIS_URL and S3_ENDPOINT are set by the
# compose file itself (internal service names / https://s3.<DOMAIN>) and do
# NOT belong here.

# --- Server / access -------------------------------------------------------
# Public hostname of the app. DNS A records must exist for both
# <DOMAIN> and s3.<DOMAIN>, pointing at the VPS.
DOMAIN=agent.example.com
# Basic auth in front of the app (the app has no login of its own).
# Generate the hash on the VPS with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# KEEP THE SINGLE QUOTES around the hash: it contains `$`, which Compose
# would otherwise treat as variable references and silently mangle.
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$replace-with-output-of-caddy-hash-password'

# --- Infrastructure secrets (pick long random strings) ----------------------
POSTGRES_PASSWORD=change-me
# Doubles as the MinIO root user/password.
S3_ACCESS_KEY_ID=sma-minio
S3_SECRET_ACCESS_KEY=change-me-long-random
S3_BUCKET=sma-media
S3_REGION=us-east-1

# --- LLM / creative providers ----------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Instagram Graph API (publish + analytics) ------------------------------
# Long-lived user token - expires after 60 days and must be refreshed.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Observability (optional) ----------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
