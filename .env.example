# --- Database ---
DATABASE_URL=postgresql://sma:sma@localhost:5434/sma

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- S3-compatible Object Storage (MinIO locally) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sma-minio
S3_SECRET_ACCESS_KEY=sma-minio-secret
S3_BUCKET=sma-media
S3_FORCE_PATH_STYLE=true

# --- LLM Provider ---
ANTHROPIC_API_KEY=

# --- Search Provider ---
TAVILY_API_KEY=

# --- Voice Provider ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Image Provider ---
OPENAI_API_KEY=

# --- Publish / Analytics (Instagram Graph API) ---
# App ID/Secret enable automatic token refresh; the access token is only a
# bootstrap value that gets stored in the DB on first use.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- App ---
NODE_ENV=development
